---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
---

<Layout title="Collections | Imprints Creations">
  <Navbar />
  <main style="padding-top: var(--nav-h);">

    <!-- Hero -->
    <section class="collections-hero">
      <img src="/images/collections/collections-hero.jpg" alt="Imprints Creations Collections" class="collections-hero-img" />
      <div class="collections-hero-overlay"></div>
      <div class="container collections-hero-content">
        <p class="eyebrow" style="color:var(--gold-secondary);">Artist Collections</p>
        <div class="divider divider-center" style="background:var(--gold-secondary);"></div>
        <h1 class="display display-xl" style="color:#fff;">
          Original artwork designed for <em style="color:var(--gold-secondary);">everyday life.</em>
        </h1>
      </div>
    </section>

    <!-- Intro -->
    <section class="section" style="background:var(--bg);">
      <div class="container" style="text-align:center; max-width:700px; margin-inline:auto;">
        <p class="eyebrow">Our Collections</p>
        <div class="divider divider-center"></div>
        <h2 class="display display-lg" style="color:var(--text);">
          More than merchandise, <em style="color:var(--gold-primary);">wearable art.</em>
        </h2>
        <p class="body-lg" style="margin-top:1.25rem;">
          Every product begins as an original piece of art before becoming
          part of our collections. Designed in-house, available exclusively
          at Imprints Creations.
        </p>
      </div>
    </section>

    <!-- Mockup Feature -->
    <section class="section" style="background:var(--warm-surface); padding-top:0;">
      <div class="container">
        <div class="mockup-feature">
          <img src="/images/collections/collections-mockup.jpg" alt="Imprints Creations artist collections" class="mockup-img" />
        </div>
      </div>
    </section>

    <!-- Products -->
    <section class="section" style="background:var(--bg);">
      <div class="container">
        <div style="text-align:center; margin-bottom:3rem;">
          <p class="eyebrow">What We Offer</p>
          <div class="divider divider-center"></div>
          <h2 class="display display-lg" style="color:var(--text);">
            Current <em style="color:var(--gold-primary);">Collections</em>
          </h2>
        </div>
        <div class="products-grid">
          <div class="product-card">
            <div class="product-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.57a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.57a2 2 0 00-1.34-2.23z"/>
              </svg>
            </div>
            <h3 class="product-title">Graphic T-Shirts</h3>
            <p class="body-md">Original artwork printed on premium quality tees. Each design is unique to Imprints Creations.</p>
          </div>
          <div class="product-card">
            <div class="product-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/>
              </svg>
            </div>
            <h3 class="product-title">Tote Bags</h3>
            <p class="body-md">Canvas tote bags featuring original Imprints designs. Practical, artistic, and exclusively ours.</p>
          </div>
          <div class="product-card">
            <div class="product-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="1"/>
                <path d="M3 9h18M9 21V9"/>
              </svg>
            </div>
            <h3 class="product-title">Posters</h3>
            <p class="body-md">High quality art prints of original works. Perfect for transforming any space.</p>
          </div>
          <div class="product-card">
            <div class="product-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="3"/>
                <line x1="12" y1="3" x2="12" y2="9"/>
                <line x1="12" y1="15" x2="12" y2="21"/>
              </svg>
            </div>
            <h3 class="product-title">Stickers</h3>
            <p class="body-md">Original artwork as stickers. Small pieces of art for your everyday items.</p>
          </div>
        </div>
        <div class="coming-soon-note">
          <p class="eyebrow">Coming Soon</p>
          <p class="body-md" style="margin-top:0.5rem;">More artist collections are on their way. Stay connected for future releases.</p>
        </div>
      </div>
    </section>

    <!-- Visit CTA -->
    <section class="section" style="background:var(--warm-surface);">
      <div class="container" style="text-align:center;">
        <p class="eyebrow">Exclusively In-Studio</p>
        <div class="divider divider-center"></div>
        <h2 class="display display-lg" style="color:var(--text);">
          Available only at <em style="color:var(--gold-primary);">our studio.</em>
        </h2>
        <p class="body-lg" style="max-width:480px; margin:1rem auto 2rem;">
          All collections are available exclusively at Imprints Creations,
          Koramangala. Visit us to explore the full range.
        </p>
        <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
          <a href="/contact" class="btn btn-primary">Get Directions</a>
          <a href="https://wa.me/919620609848" target="_blank" class="btn btn-outline">WhatsApp Us</a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <img src="/images/logo/logo.svg" alt="Imprints Creations" class="footer-logo-img" />
            <p class="footer-brand-tagline">Welcome, Free Soul.</p>
            <p style="font-size:13px; color:rgba(255,253,249,0.5); margin-top:0.75rem; line-height:1.6;">
              1023, 3rd Floor, 80 Feet Road<br />
              Koramangala 1st Block<br />
              Bengaluru
            </p>
            <p style="font-size:13px; color:rgba(255,253,249,0.5); margin-top:0.5rem;">
              +91 9620609848
            </p>
            <div class="footer-social" style="margin-top:1.25rem;">
              <a href="https://instagram.com/imprintscreations" target="_blank">Instagram</a>
              <a href="https://wa.me/919620609848" target="_blank">WhatsApp</a>
            </div>
          </div>
          <div>
            <p class="footer-heading">Navigate</p>
            <ul class="footer-links">
              <li><a href="/">Home</a></li>
              <li><a href="/studio">Studio</a></li>
              <li><a href="/artwork">Artwork</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-heading">Studio</p>
            <ul class="footer-links">
              <li><a href="/studio#styles">Tattoo Styles</a></li>
              <li><a href="/studio#piercing">Piercing</a></li>
              <li><a href="/studio#aftercare">Aftercare</a></li>
              <li><a href="/contact">Book a Consultation</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-heading">Connect</p>
            <ul class="footer-links">
              <li><a href="https://instagram.com/imprintstattoos" target="_blank">@imprintstattoos</a></li>
              <li><a href="https://instagram.com/imprintscreations" target="_blank">@imprintscreations</a></li>
              <li><a href="https://wa.me/919620609848" target="_blank">WhatsApp</a></li>
              <li><a href="https://share.google/6woIQnfHs7hUAQbKP" target="_blank">Google Reviews</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© 2025 Imprints Creations. All rights reserved.</p>
          <p>Koramangala, Bengaluru</p>
        </div>
      </div>
    </footer>

  </main>
</Layout>

<style>
  .collections-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .collections-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .collections-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15,12,8,0.65);
  }
  .collections-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mockup-feature {
    max-width: 900px;
    margin-inline: auto;
    border: 1px solid var(--border-warm);
    overflow: hidden;
  }
  .mockup-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .product-card {
    padding: 2.5rem 2rem;
    border: 1px solid var(--border-warm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    align-items: center;
    transition: border-color 0.3s ease;
  }
  .product-card:hover { border-color: var(--gold-secondary); }
  .product-icon { color: var(--gold-primary); }
  .product-title {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }

  .coming-soon-note {
    text-align: center;
    padding: 2rem;
    border: 1px dashed var(--border-warm);
    max-width: 500px;
    margin-inline: auto;
  }

  @media (max-width: 900px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .products-grid { grid-template-columns: 1fr 1fr; }
  }
</style>