---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
---

<Layout title="Imprints Creations | Tattoos • Artwork • Collections">
  <Navbar />
  <main style="padding-top: var(--nav-h);">

    <!-- Hero -->
    <section class="hero-section">
      <img src="/images/hero/hero-bg.jpg" alt="Imprints Creations Studio" class="hero-img" />
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <p class="eyebrow" style="color:var(--gold-secondary);">Imprints Creations</p>
        <div class="divider divider-center" style="background:var(--gold-secondary);"></div>
        <h1 class="display display-xl hero-title">
          Welcome, <em>Free Soul.</em>
        </h1>
        <p class="body-lg" style="max-width:500px; margin-top:1.5rem; color:rgba(255,253,249,0.85);">
          Where ideas become art, stories become tattoos,
          and creativity finds its form.
        </p>
        <a href="/studio" class="btn btn-primary" style="margin-top:2rem;">
          Explore Our World
        </a>
      </div>
    </section>

    <!-- Our World -->
    <section class="section" style="background: var(--bg);">
      <div class="container">
        <div style="max-width:640px; margin-bottom:4rem; margin-inline:auto; text-align:center;">
          <p class="eyebrow">Our World</p>
          <div class="divider divider-center"></div>
          <h2 class="display display-lg" style="color:var(--text);">
            Creativity has no <em style="color:var(--gold-primary);">boundaries.</em>
          </h2>
          <p class="body-lg" style="margin-top:1.25rem;">
            At Imprints, we bring together tattoos, original artwork,
            and artist-designed collections under one creative space where every
            piece begins with purpose.
          </p>
        </div>
        <div class="world-grid">
          <div class="world-card">
            <div class="world-card-img">
              <img src="/images/home/world-artwork.jpg" alt="Original Artwork" />
            </div>
            <div class="world-card-body">
              <p class="eyebrow">Original Artwork</p>
              <h3 class="display display-sm" style="color:var(--text);">Art that transforms spaces.</h3>
              <a href="/artwork" class="btn btn-ghost">Explore Gallery</a>
            </div>
          </div>
          <div class="world-card">
            <div class="world-card-img">
              <img src="/images/home/world-studio.jpg" alt="The Studio" />
            </div>
            <div class="world-card-body">
              <p class="eyebrow">The Studio</p>
              <h3 class="display display-sm" style="color:var(--text);">Every tattoo starts with a conversation.</h3>
              <a href="/studio" class="btn btn-ghost">Explore Studio</a>
            </div>
          </div>
          <div class="world-card">
            <div class="world-card-img">
              <img src="/images/home/world-collections.jpg" alt="Collections" />
            </div>
            <div class="world-card-body">
              <p class="eyebrow">Collections</p>
              <h3 class="display display-sm" style="color:var(--text);">Original art as everyday pieces.</h3>
              <a href="/collections" class="btn btn-ghost">Explore Collections</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Studio Feature -->
    <section class="studio-feature">
      <img src="/images/home/studio-banner.jpg" alt="The Studio" class="studio-feature-img" />
      <div class="studio-feature-overlay"></div>
      <div class="container studio-feature-content">
        <p class="eyebrow" style="color:var(--gold-secondary);">The Studio</p>
        <div class="divider divider-center" style="background:var(--gold-secondary);"></div>
        <h2 class="display display-lg" style="color:#fff;">
          A space where creativity feels <em style="color:var(--gold-secondary);">personal.</em>
        </h2>
        <p class="body-lg" style="color:rgba(255,253,249,0.75); max-width:580px; margin-top:1rem;">
          Great tattoos aren't created in a hurry. They're built through trust, collaboration, and an environment where you can relax, share your ideas, and enjoy the journey from concept to completion.
        </p>
        <a href="/studio" class="btn btn-primary" style="margin-top:1.5rem;">Explore Studio</a>
      </div>
    </section>

    <!-- Recent Tattoos -->
    <section class="section" style="background:var(--bg);">
      <div class="container">
        <div style="max-width:640px; margin-bottom:3rem; margin-inline:auto; text-align:center;">
          <p class="eyebrow">Recent Tattoos</p>
          <div class="divider divider-center"></div>
          <h2 class="display display-lg" style="color:var(--text);">
            Creativity, made <em style="color:var(--gold-primary);">personal.</em>
          </h2>
          <p class="body-lg" style="margin-top:1.25rem;">
            Every tattoo begins with a story or inspiration, shaped through conversation, creativity, and trust. Explore a selection of custom pieces created at Imprints.
          </p>
        </div>
        <div class="preview-grid">
          <a href="/studio" class="preview-item">
            <img src="/images/home/tattoo-preview-01.jpg" alt="Fine Line tattoo" />
            <div class="preview-overlay"><span>Fine Line</span></div>
          </a>
          <a href="/studio" class="preview-item">
            <img src="/images/home/tattoo-preview-02.jpg" alt="Minimal tattoo" />
            <div class="preview-overlay"><span>Minimal</span></div>
          </a>
          <a href="/studio" class="preview-item">
            <img src="/images/home/tattoo-preview-03.jpg" alt="Traditional tattoo" />
            <div class="preview-overlay"><span>Traditional</span></div>
          </a>
          <a href="/studio" class="preview-item">
            <img src="/images/home/tattoo-preview-04.jpg" alt="Portrait tattoo" />
            <div class="preview-overlay"><span>Portrait</span></div>
          </a>
          <a href="/studio" class="preview-item">
            <img src="/images/home/tattoo-preview-05.jpg" alt="Color tattoo" />
            <div class="preview-overlay"><span>Color</span></div>
          </a>
          <a href="/studio" class="preview-item">
            <img src="/images/home/tattoo-preview-06.jpg" alt="Creative tattoo" />
            <div class="preview-overlay"><span>Creative</span></div>
          </a>
        </div>
        <div style="text-align:center; margin-top:2.5rem;">
          <a href="/studio" class="btn btn-outline">Explore Studio</a>
        </div>
      </div>
    </section>

    <!-- Original Artwork -->
    <section class="section" style="background:var(--warm-surface);">
      <div class="container">
        <div style="max-width:640px; margin-bottom:3rem; margin-inline:auto; text-align:center;">
          <p class="eyebrow">Original Artwork</p>
          <div class="divider divider-center"></div>
          <h2 class="display display-lg" style="color:var(--text);">
            Where Creativity <em style="color:var(--gold-primary);">Continues.</em>
          </h2>
          <p class="body-lg" style="margin-top:1.25rem;">
            From expressive paintings to detailed sketches and commissioned pieces, every artwork reflects the same creativity and craftsmanship found in our studio.
          </p>
        </div>
        <div class="preview-grid">
          <a href="/artwork" class="preview-item">
            <img src="/images/home/artwork-preview-01.jpg" alt="Paintings" />
            <div class="preview-overlay"><span>Paintings</span></div>
          </a>
          <a href="/artwork" class="preview-item">
            <img src="/images/home/artwork-preview-02.jpg" alt="Sketches" />
            <div class="preview-overlay"><span>Sketches</span></div>
          </a>
          <a href="/artwork" class="preview-item">
            <img src="/images/home/artwork-preview-03.jpg" alt="Portraits" />
            <div class="preview-overlay"><span>Portraits</span></div>
          </a>
          <a href="/artwork" class="preview-item">
            <img src="/images/home/artwork-preview-04.jpg" alt="Abstract" />
            <div class="preview-overlay"><span>Abstract</span></div>
          </a>
          <a href="/artwork" class="preview-item">
            <img src="/images/home/artwork-preview-05.jpg" alt="Canvas Art" />
            <div class="preview-overlay"><span>Canvas Art</span></div>
          </a>
          <a href="/artwork" class="preview-item">
            <img src="/images/home/artwork-preview-06.jpg" alt="Commissioned" />
            <div class="preview-overlay"><span>Commissioned</span></div>
          </a>
        </div>
        <div style="text-align:center; margin-top:2.5rem;">
          <a href="/artwork" class="btn btn-outline">Explore Gallery</a>
        </div>
      </div>
    </section>

    <!-- Founder -->
    <section class="section" style="background:var(--bg);">
      <div class="container">
        <div class="founder-grid">
          <div class="founder-img-wrap">
            <img src="/images/home/naveen.jpg" alt="Naveen Nambiar" class="founder-photo" />
            <div class="founder-accent"></div>
          </div>
          <div class="founder-text">
            <p class="eyebrow">Meet the Founder</p>
            <div class="divider"></div>
            <h2 class="display display-lg" style="color:var(--text);">
              Naveen <em style="color:var(--gold-primary);">Nambiar</em>
            </h2>
            <p style="font-size:13px; letter-spacing:0.12em; text-transform:uppercase; color:var(--neutral-gray); margin:0.5rem 0 1.5rem;">
              Founder & Lead Artist
            </p>
            <p class="body-lg">
              What began as a lifelong passion for art grew into Imprints,
              a creative space where ideas take shape through tattoos, original artwork,
              and thoughtfully designed collections.
            </p>
            <p class="body-lg" style="margin-top:1rem;">
              With a creative career spanning Marketing & Brand Design in the architecture industry, followed by Graphic Design and UI Design at global organizations like Infosys and IBM, Naveen developed a deep appreciation for thoughtful design and visual storytelling. As his passion for tattooing continued to grow, he chose to dedicate himself fully to Imprints, a studio where creativity, craftsmanship, and meaningful experiences come together.
            </p>
            <blockquote class="founder-quote">
              "The best tattoos aren't just designed. They're understood, created together, and made uniquely yours."
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- Google Reviews -->
    <section class="section" style="background:var(--warm-surface);">
      <div class="container" style="text-align:center;">
        <p class="eyebrow">Google Reviews</p>
        <div class="divider divider-center"></div>
        <h2 class="display display-lg" style="color:var(--text);">
          Trusted by hundreds of <em style="color:var(--gold-primary);">happy clients.</em>
        </h2>
        <p class="body-lg" style="max-width:520px; margin:1rem auto 2rem;">
          From first tattoos to meaningful custom artwork, every review reflects the care, comfort, and creativity that define the Imprints experience.
        </p>
        <a href="https://share.google/6woIQnfHs7hUAQbKP" target="_blank" class="btn btn-outline">Read More Reviews</a>
      </div>
    </section>

    <!-- Visit CTA -->
    <section class="section" style="background:var(--bg);">
      <div class="container" style="text-align:center;">
        <p class="eyebrow">Visit the Studio</p>
        <div class="divider divider-center"></div>
        <h2 class="display display-lg" style="color:var(--text);">
          We'd love to <em style="color:var(--gold-primary);">welcome you.</em>
        </h2>
        <p class="body-lg" style="max-width:480px; margin:1rem auto 2rem;">
          Whether you're planning your next tattoo, exploring original artwork,
          or discovering our latest collections, come find us in Koramangala.
        </p>
        <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
          <a href="/contact" class="btn btn-primary">Get Directions</a>
          <a href="https://wa.me/919620609848" target="_blank" class="btn btn-outline">WhatsApp Us</a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <img src="/images/logo/logo.svg" alt="Imprints Creations" class="footer-logo-img" />
            <p class="footer-brand-tagline">Welcome, Free Soul.</p>
            <p style="font-size:13px; color:rgba(255,253,249,0.5); margin-top:0.75rem; line-height:1.6;">
              1023, 3rd Floor, 80 Feet Road<br />
              Koramangala 1st Block<br />
              Bengaluru
            </p>
            <p style="font-size:13px; color:rgba(255,253,249,0.5); margin-top:0.5rem;">
              +91 9620609848
            </p>
            <div class="footer-social" style="margin-top:1.25rem;">
              <a href="https://instagram.com/imprintscreations" target="_blank">Instagram</a>
              <a href="https://wa.me/919620609848" target="_blank">WhatsApp</a>
            </div>
          </div>
          <div>
            <p class="footer-heading">Navigate</p>
            <ul class="footer-links">
              <li><a href="/studio">Studio</a></li>
              <li><a href="/artwork">Artwork</a></li>
              <li><a href="/collections">Collections</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-heading">Studio</p>
            <ul class="footer-links">
              <li><a href="/studio#styles">Tattoo Styles</a></li>
              <li><a href="/studio#piercing">Piercing</a></li>
              <li><a href="/studio#aftercare">Aftercare</a></li>
              <li><a href="/contact">Book a Consultation</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-heading">Connect</p>
            <ul class="footer-links">
              <li><a href="https://instagram.com/imprintstattoos" target="_blank">@imprintstattoos</a></li>
              <li><a href="https://instagram.com/imprintscreations" target="_blank">@imprintscreations</a></li>
              <li><a href="https://wa.me/919620609848" target="_blank">WhatsApp</a></li>
              <li><a href="https://share.google/6woIQnfHs7hUAQbKP" target="_blank">Google Reviews</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© 2025 Imprints Creations. All rights reserved.</p>
          <p>Koramangala, Bengaluru</p>
        </div>
      </div>
    </footer>

  </main>
</Layout>

<style>
  .hero-section {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(15,12,8,0.3) 0%, rgba(15,12,8,0.65) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-title { color: #fff; margin-top: 0.5rem; }
  .hero-title em { font-style: italic; color: var(--gold-secondary); }

  .world-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .world-card-img {
    height: 360px;
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .world-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .world-card:hover .world-card-img img { transform: scale(1.05); }
  .world-card-body {
    padding: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .studio-feature {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .studio-feature-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .studio-feature-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15,12,8,0.72);
  }
  .studio-feature-content {
    position: relative;
    z-index: 2;
    padding-block: 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 700px;
    margin-inline: auto;
  }

  /* Preview Grid (Recent Tattoos / Artwork) */
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
  }
  .preview-item {
    position: relative;
    aspect-ratio: 2/3;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 0.85rem;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .preview-item:hover img { transform: scale(1.08); }
  .preview-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15,12,8,0.75) 0%, rgba(15,12,8,0) 50%);
    display: flex;
    align-items: flex-end;
    padding: 0.85rem;
  }
  .preview-overlay span {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }

  .founder-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    align-items: center;
  }
  .founder-img-wrap { position: relative; }
  .founder-photo {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .founder-accent {
    position: absolute;
    bottom: -14px; right: -14px;
    width: 78%; height: 78%;
    border: 1px solid var(--gold-secondary);
    z-index: -1;
  }
  .founder-quote {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-style: italic;
    font-weight: 300;
    color: var(--gold-primary);
    border-left: 2px solid var(--gold-secondary);
    padding-left: 1.25rem;
    margin-top: 2rem;
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .preview-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .world-grid { grid-template-columns: 1fr; }
    .founder-grid { grid-template-columns: 1fr; gap: 3rem; }
    .founder-photo { aspect-ratio: 3/2; }
  }
  @media (max-width: 600px) {
    .preview-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>